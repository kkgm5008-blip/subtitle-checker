{
  "manifestVersion": 5,
  "id": "com.kkgm5008.subtitle-checker",
  "name": "자막 맞춤법 · AI 컨펌",
  "version": "1.3.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "request",
    "launchProcess": {
      "schemes": ["https"],
      "extensions": []
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "subtitleCheckerPanel",
      "label": {
        "default": "자막 맞춤법 · AI 컨펌"
      },
      "minimumSize": { "width": 300, "height": 400 },
      "maximumSize": { "width": 2000, "height": 3000 },
      "preferredDockedSize": { "width": 380, "height": 720 },
      "preferredFloatingSize": { "width": 420, "height": 760 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/dark.svg", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/light.svg", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin-icon.svg", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light", "all"], "species": ["pluginList"] }
  ]
}
